{
  "expo": {
    "name": "Voice Control",
    "slug": "voice-control-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.voicecontrol.app",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "@react-native-voice/voice"
    ]
  }
}
